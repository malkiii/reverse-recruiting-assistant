# Both the dashboard and Functions

# Supabase transaction pooler connection string, port 6543
DATABASE_URL=

# Bearer secret the dashboard sends to Functions
FUNCTIONS_SECRET=

# Google OAuth client (Web application) that connects the Admin's Gmail and Drive.
# Both sides refresh the stored Google connection with it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Functions only

# Apify API tokens, separated by commas
APIFY_TOKENS=

# Firecrawl API key, for reading Job Feeds and Job pages
FIRECRAWL_API_KEY=

# Telegram bot and the Admin's chat that receive Failure Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public URL of the dashboard, linked from Failure Alerts
DASHBOARD_URL=

# Dashboard only

# Password for signing in to the dashboard
DASHBOARD_PASSWORD=

# Base URL of the Functions: the Modal web endpoint on Vercel.
# Compose sets this to the local worker itself.
FUNCTIONS_BASE_URL=

# Where "today" starts on the dashboard, e.g. Africa/Algiers. Defaults to UTC.
TIMEZONE=
